   "source": [
    "## **Standard Brownian Motion**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "67a460ca-ce41-4eec-94a2-4233e060ef82",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "tmax = 10\n",
    "T = np.linspace(0, tmax, 1000)\n",
    "dt = T[1] - T[0]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "dac7e946-0558-498c-a51d-14af88cf5aa6",
   "metadata": {},
   "outputs": [],
   "source": [
    "dB = np.random.normal(0, np.sqrt(dt), 1000)\n",
    "B = np.zeros(1001)\n",
    "B[1:] = np.cumsum(dB)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "aaa7f55c-90ee-4a94-ac21-f0c70ea22762",
   "metadata": {},
   "outputs": [
